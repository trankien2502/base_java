<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivLeague"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/img_logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvLeagueName"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp"
            android:fontFamily="@font/sf_pro_text_medium"
            android:includeFontPadding="false"
            android:text="@string/league"
            android:textColor="#292D32"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/ivHide"
            app:layout_constraintStart_toEndOf="@id/ivLeague" />

        <ImageView
            android:id="@+id/ivHide"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/expand_up"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvFixture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/clHeader"
        android:nestedScrollingEnabled="false"
        tools:listitem="@layout/item_fixture_home" />
</androidx.constraintlayout.widget.ConstraintLayout>
