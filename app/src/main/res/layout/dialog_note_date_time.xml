<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:background="@drawable/bg_dialog"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.livescore.soccerscore.matchlive.util.calendar_collapse.widget.CollapsibleCalendar
            android:id="@+id/view_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:elevation="@dimen/_2sdp"
            android:padding="@dimen/_6sdp"
            app:primaryColor="@color/white"
            app:selectedItem_background="@drawable/bg_radius_100_select_day"
            app:selectedItem_textColor="@color/white"
            app:textColor="#0A1640"
            app:todayItem_background="@drawable/bg_radius_100_this_day"
            app:todayItem_textColor="#0075C8" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_18sdp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/_12sdp"
                android:layout_weight="1"
                android:background="@drawable/bg_radius_100"
                android:backgroundTint="#F0F0F0"
                android:ellipsize="end"
                android:fontFamily="@font/svn_gilroy"
                android:gravity="center"

                android:singleLine="true"
                android:text="@string/cancel"
                android:textColor="#8D8D8D"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_save"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_radius_100"
                android:backgroundTint="#07B0F8"
                android:ellipsize="end"
                android:fontFamily="@font/svn_gilroy"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/save"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>


</RelativeLayout>