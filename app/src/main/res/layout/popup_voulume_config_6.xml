                        app:vsb_bar_corner_radius="16dp"
                        app:vsb_bar_progress_gradient_end="#39BDFF"
                        app:vsb_bar_progress_gradient_start="#39BDFF"
                        app:vsb_bar_width="8dp"
                        app:vsb_max_value="100"
                        app:vsb_progress="50"
                        app:vsb_show_thumb="true"
                        app:vsb_thumb_container_corner_radius="100dp"
                        app:vsb_thumb_container_tint="#00000000"
                        app:vsb_thumb_placeholder_src="@drawable/thumb_style_6"
                        app:vsb_use_thumb_to_set_progress="true" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivNotification"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginBottom="24dp"
                    android:padding="2dp"
                    android:src="@drawable/ic_notification"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:tint="#39BDFF" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.assistivetouch.easytouch.homebutton.util.widget.UiLinearLayout>

