            android:layout_height="300dp"
            android:layout_marginHorizontal="3dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"


            android:visibility="visible"
            app:bgColorLight="#ffffff"
            app:cornerRadius="12dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toTopOf="@id/ivDark"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.lukelorusso.verticalseekbar.VerticalSeekBar
                        android:id="@+id/sbDark"
                        android:layout_width="20dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        app:vsb_bar_background="#F0F0F0"
                        app:vsb_bar_corner_radius="16dp"
                        app:vsb_bar_progress_gradient_end="#39BDFF"
